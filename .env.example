# @BotFather bergan token
BOT_TOKEN=

# 2 GB gacha video uchun (faqat serverda, docker compose bilan): my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Nutqni o'girish: kalit bo'lsa ElevenLabs avtomatik, bo'lmasa Whisper
ELEVENLABS_API_KEY=
WHISPER_MODEL=large-v3

# Sinov paytida faqat shu Telegram ID'lar ishlata oladi (vergul bilan). Bo'sh = hamma.
ALLOWED_IDS=

# Render tezligi: veryfast (tez) yoki medium (sifatliroq)
X264_PRESET=veryfast
